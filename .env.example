# Neon pooled connection string (runtime queries)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection string — used by migrations.
# Optional: falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# The password that gates the whole app. Pick something long and random.
# Changing it signs out every existing session.
APP_PASSWORD=""

# IANA timezone used to resolve "today" (default: UTC)
APP_TIMEZONE="UTC"

# Web push (daily reminder). Generate both with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push service, mailto: or https: URL
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for the cron endpoint. Vercel sends it automatically as a
# Bearer token when this env var is set. Any long random string.
CRON_SECRET=""

# Neon pooled connection string (runtime queries)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection string — used by migrations.
# Optional: falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# The password that gates the whole app. Pick something long and random.
# Changing it signs out every existing session.
APP_PASSWORD=""

# IANA timezone used to resolve "today" (default: UTC)
APP_TIMEZONE="UTC"
